# --- Rust build artifacts ---
/target
**/*.rs.bk
*.pdb
*.exe

# --- Secrets and local environment ---
!.env.example
*.pem
*.key
!docker/**/*.key

# --- Local databases and dumps ---
*.sql
!migrations/*.sql
*.dump
*.backup
/pgdata
/tmp

# --- OpenCode local overrides ---
# `.opencode/opencode.jsonc` is the per-clone override slot. It is intentionally
# untracked so a contributor can change the model/permissions for their machine
# without ever committing personal settings. See docs/contributing.md.
/.opencode/opencode.jsonc
/.opencode/opencode.json

# --- SQLx offline query metadata ---
# Regenerate with `cargo sqlx prepare`. Uncomment once the project adopts
# compile-time-checked queries and CI verifies the metadata is current.
# /.sqlx

# --- Editors and OS ---
.idea/
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# --- Test and coverage output ---
/coverage
*.profraw
/tarpaulin-report.html
config.bat
node_modules
