# ATOM API — example environment file.
#
# Copy to `.env` for local development and replace every placeholder.
# `.env` is git-ignored. Never commit real credentials.
#
#   cp .env.example .env          # Linux/macOS
#   Copy-Item .env.example .env   # Windows PowerShell
#
# These variables override the matching keys in `config/`. See
# `config/README.md` for the full precedence model and the complete list of
# settings.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Optional. A directory of configuration files that is merged on top of the
# files embedded in the binary. The named directory must exist; a path that
# does not is a start-up error. Leave it unset to use the embedded files only.
ATOM_CONFIG_DIR=

# Which environment the process runs in: `development` (also `dev`, `local`)
# or `production` (also `prod`). Production enables the fail-fast checks on the
# placeholder secret.
APP_ENV=development

# Bind address for the HTTP server. Use 127.0.0.1 for local development.
APP_BIND_ADDR=127.0.0.1:3000

# Comma-separated list of allowed CORS origins. `*` is rejected. An empty
# value disables CORS entirely, which is correct for an API that is not
# reachable from a browser. The committed configuration leaves it empty; set
# it here only when a browser client needs it.
APP_CORS_ALLOWED_ORIGINS=

# Whether the OpenAPI document and the API explorer are served.
APP_API_DOCS_ENABLED=true

# Maximum accepted request body size in bytes (default 1 MiB).
APP_MAX_BODY_BYTES=1048576

# Maximum time a request may take before it is abandoned, in seconds.
APP_REQUEST_TIMEOUT_SECONDS=30

# How long the readiness probe waits for the database, in seconds.
APP_READINESS_PROBE_TIMEOUT_SECONDS=1

# The ceiling on how long in-flight requests may finish after the process is
# asked to stop, in seconds. The server stops accepting new connections as soon
# as it receives the signal, then drains; this value bounds that drain.
APP_SHUTDOWN_GRACE_SECONDS=10

# How often expired refresh sessions are pruned, and how long they are kept.
# The grace is how long an expired session row survives; it may not be lowered
# below one hour.
APP_SESSION_PRUNE_INTERVAL_SECONDS=3600
APP_SESSION_PRUNE_GRACE_SECONDS=86400

# Log filter, e.g. `info`, `debug`, `atom_api=trace,tower_http=debug`.
APP_LOG_FILTER=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The application role must be able to create/alter objects in the target
# database so that the migrations can be applied.
# The seeder refuses a non-development name, so this is `atom_dev`, not `atom`.
DATABASE_URL=postgres://atom:atom@127.0.0.1:5432/atom_dev

# Maximum number of pooled connections.
DATABASE_MAX_CONNECTIONS=10
# Acquire timeout in seconds.
DATABASE_ACQUIRE_TIMEOUT_SECS=5
# Connect timeout in seconds.
DATABASE_CONNECT_TIMEOUT_SECS=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing secret for access tokens. MUST be replaced.
# Generate a development value with:
#   openssl rand -base64 48
# Production MUST use at least 32 random bytes from a secret manager.
APP_JWT_SECRET=replace-me-with-a-development-only-secret-at-least-32-bytes-long

# Access token lifetime in seconds (default 900 = 15 minutes).
APP_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds (default 1209600 = 14 days).
APP_REFRESH_TOKEN_TTL_SECONDS=1209600

# Clock-skew allowance when validating an access token, in seconds.
APP_ACCESS_TOKEN_CLOCK_SKEW_SECONDS=30

# Issuer claim written into, and required from, access tokens.
APP_JWT_ISSUER=atom-api
# Audience claim written into, and required from, access tokens.
APP_JWT_AUDIENCE=atom-api

# Argon2id parameters. Increase the cost parameters in production.
# m_cost = memory in KiB, t_cost = iterations, p_cost = parallelism.
# The memory may not be lowered below 8192 KiB.
APP_ARGON2_MEMORY_KIB=19456
APP_ARGON2_ITERATIONS=2
APP_ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Rate limiting (per process, in-memory)
# ---------------------------------------------------------------------------
# Maximum authentication attempts allowed per client IP in one window.
APP_AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Rate limit window in seconds.
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Local machine learning (ADR-0008)
# ---------------------------------------------------------------------------
# ML is off by default: the embedder is `disabled`, a semantic or hybrid search
# answers `200` with lexical results, and a match or a reindex answers `409`.
# Nothing reads a model file unless this is `true`.
APP_ML_ENABLED=false

# The backend: `flex` or `deterministic`. Any other value is a start-up error.
# `deterministic` needs no model file and no network; the test suite and the
# seeder use it.
APP_ML_BACKEND=flex

# The local SafeTensors file. Leave empty to configure no model. A path that
# does not exist selects the disabled embedder, and start-up still succeeds.
APP_ML_MODEL_PATH=

# The WordPiece vocabulary. Leave empty to use the `vocab.txt` beside the
# weights.
APP_ML_TOKENIZER_PATH=

# The vector length the embedder must produce. Greater than zero.
APP_ML_DIMENSION=384

# The budget for one inference, in seconds. Positive, and at most
# APP_REQUEST_TIMEOUT_SECONDS. It does not bound the hybrid re-rank, which
# performs no inference.
APP_ML_TIMEOUT_SECONDS=2

# The largest lexical candidate set a hybrid search re-ranks, and the work bound
# of one re-rank. Positive, and at most 1000. It has no relation to the page
# size: a short page is well formed.
APP_ML_CANDIDATE_LIMIT=200

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The integration test suite applies migrations to this database and creates a
# unique user per test. It never truncates shared tables. The harness refuses
# to run unless the database name contains `test`, so it MUST NOT point at a
# production database.
TEST_DATABASE_URL=postgres://atom:atom@127.0.0.1:5432/atom_test
