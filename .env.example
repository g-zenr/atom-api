# ATOM API — example environment file.
#
# Copy to `.env` for local development and replace every placeholder.
# `.env` is git-ignored. Never commit real credentials.
#
#   cp .env.example .env          # Linux/macOS
#   Copy-Item .env.example .env   # Windows PowerShell

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Bind address for the HTTP server. Use 127.0.0.1 for local development.
APP_BIND_ADDR=127.0.0.1:3000

# Comma-separated list of allowed CORS origins. `*` is rejected when
# credentials are enabled. Leave empty to disable CORS entirely.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Maximum accepted request body size in bytes (default 1 MiB).
APP_MAX_BODY_BYTES=1048576

# Maximum time a request may take before it is abandoned, in seconds.
APP_REQUEST_TIMEOUT_SECONDS=30

# Log filter, e.g. `info`, `debug`, `atom_api=trace,tower_http=debug`.
APP_LOG_FILTER=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The application role must be able to create/alter objects in the target
# database so that `sqlx migrate run` works.
DATABASE_URL=postgres://atom:atom@127.0.0.1:5432/atom

# Maximum number of pooled connections.
DATABASE_MAX_CONNECTIONS=10
# Acquire timeout in seconds.
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing secret for access tokens. MUST be replaced.
# Generate a development value with:
#   openssl rand -base64 48
# Production MUST use at least 32 random bytes from a secret manager.
APP_JWT_SECRET=replace-me-with-a-development-only-secret-at-least-32-bytes-long

# Access token lifetime in seconds (default 900 = 15 minutes).
APP_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds (default 1209600 = 14 days).
APP_REFRESH_TOKEN_TTL_SECONDS=1209600

# Issuer claim written into, and required from, access tokens.
APP_JWT_ISSUER=atom-api
# Audience claim written into, and required from, access tokens.
APP_JWT_AUDIENCE=atom-api

# Argon2id parameters. Increase the cost parameters in production.
# m_cost = memory in KiB, t_cost = iterations, p_cost = parallelism.
APP_ARGON2_MEMORY_KIB=19456
APP_ARGON2_ITERATIONS=2
APP_ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Rate limiting (per process, in-memory)
# ---------------------------------------------------------------------------
# Maximum authentication attempts allowed per client IP in one window.
APP_AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Rate limit window in seconds.
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The integration test suite applies migrations to this database and creates a
# unique user per test. It never truncates shared tables. The harness refuses
# to run unless the database name contains `test`, so it MUST NOT point at a
# production database.
TEST_DATABASE_URL=postgres://atom:atom@127.0.0.1:5432/atom_test
